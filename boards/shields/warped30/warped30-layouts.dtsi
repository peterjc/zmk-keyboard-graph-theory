#include <physical_layouts.dtsi>

    /* Physical layout close to this:
     *
     * ┌───┬───┬───┬───┐          ┌───┬───┬───┬───┐
     * │ Q │ W │ E │ R ├───┐  ┌───┤ U │ I │ O │ P │
     * ├───┼───┼───┼───┤ T │  │ Y ├───┼───┼───┼───┤
     * │ A │ S │ D │ F ├───┤  ├───┤ J │ K │ L │ ; │
     * ├───┼───┼───┼───┤ G │  │ H ├───┼───┼───┼───┤
     * │ Z │ X │ C │ V ├───┘  └───┤ M │ , │ . │ / │
     * └───┴───┴───┴───┘          └───┴───┴───┴───┘
     *                 ┌───┐  ┌───┐
     *                 │ B │  │ N │
     *                 └───┘  └───┘
     *
     * Logical rows as used in the DTSI file:
     *
     * Q        W       E       R       T          Y       U       I       O       P
     * A        S       D       F       G          H       J       K       L       ;
     * Z        X       C       V       B          N       M       ,       .       /
     *
     * The RC(#, #) columns and row value below are the scanning matrix (GPIOs),
     * scanning rows are not physical! Scanning cols 0-4 on left, then 5-9 on the right.
     */

/ {

    matrix_transform30: matrix_transform30 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <15>;
        map = <
            RC(0,0) RC(0,1) RC(2,2) RC(2,3) RC(4,4)     RC(10,5) RC(13,6) RC(13,7) RC(11,8) RC(11,9)
            RC(5,0) RC(6,1) RC(7,2) RC(8,3) RC(3,4)     RC(14,5) RC(6,6)  RC(8,7)  RC(5,8)  RC(7,9)
            RC(4,0) RC(1,1) RC(1,2) RC(3,3) RC(9,4)     RC(9,5)  RC(14,6) RC(12,7) RC(12,8) RC(10,9)
        >;
    };

    physical_layout30: physical_layout30 {
        compatible = "zmk,physical-layout";
        display-name = "LAYOUT";

        kscan = <&kscan0>;
        transform = <&matrix_transform30>;

        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 150   35   10    1000    86    81>
            , <&key_physical_attrs 100 100  139    5    1000   189    55>
            , <&key_physical_attrs 100 100  274    0    1800   324    50>
            , <&key_physical_attrs 100 100  367   84    2200   417   134>
            , <&key_physical_attrs 100 100  443  169    2200   493   219>
            , <&key_physical_attrs 100 100  969  169 (-2200)  1019   219>
            , <&key_physical_attrs 100 100 1045   84 (-2200)  1095   134>
            , <&key_physical_attrs 100 100 1138    0 (-1800)  1188    50>
            , <&key_physical_attrs 100 100 1273    5 (-1000)  1323    55>
            , <&key_physical_attrs 100 150 1377   10 (-1000)  1426    81>
            , <&key_physical_attrs 100 100    0  162       0     0     0>
            , <&key_physical_attrs 100 100  123  101    1000   173   151>
            , <&key_physical_attrs 100 100  246   92    1800   296   142>
            , <&key_physical_attrs 100 100  333  174    2200   383   224>
            , <&key_physical_attrs 100 100  409  259    2200   459   309>
            , <&key_physical_attrs 100 100 1004  259 (-2200)  1054   309>
            , <&key_physical_attrs 100 100 1079  174 (-2200)  1129   224>
            , <&key_physical_attrs 100 100 1167   92 (-1800)  1217   142>
            , <&key_physical_attrs 100 100 1289  101 (-1000)  1339   151>
            , <&key_physical_attrs 100 100 1412  162       0     0     0>
            , <&key_physical_attrs 100 100    0  260       0     0     0>
            , <&key_physical_attrs 100 100  107  196    1000   157   246>
            , <&key_physical_attrs 100 100  217  185    1800   267   235>
            , <&key_physical_attrs 100 100  299  264    2200   349   314>
            , <&key_physical_attrs 175 100  360  418    3700   445   468>
            , <&key_physical_attrs 175 100  983  418 (-3700)  1068   468>
            , <&key_physical_attrs 100 100 1113  264 (-2200)  1163   314>
            , <&key_physical_attrs 100 100 1195  185 (-1800)  1245   235>
            , <&key_physical_attrs 100 100 1305  196 (-1000)  1355   246>
            , <&key_physical_attrs 100 100 1412  260       0     0     0>
            ;
    };
};
